OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Active routing (OpenRouter is the ONLY gateway — no direct OpenAI SDK/API):
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
OPENROUTER_CREATIVE_MODEL=openai/gpt-5.6-luna
OPENROUTER_FINAL_SCRIPT_MODEL=openai/gpt-5.6-luna
OPENROUTER_VALIDATION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_REASONING_EFFORT=medium
# Previous Gemini routing, INACTIVE (kept only for rollback). Setting ONLY
# OPENROUTER_TEXT_MODEL to a Gemini model silently routes creative, final-script
# AND validation to Gemini, because each falls back to the text model when unset:
# OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# OPENROUTER_CREATIVE_MODEL=google/gemini-2.5-flash
# OPENROUTER_FINAL_SCRIPT_MODEL=google/gemini-2.5-pro
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
PEXELS_API_KEY=xxxxxxxx
PIXABAY_API_KEY=xxxxxxxx
# Set to false to stop actual image-generation provider calls (e.g. while
# iterating on script generation) without touching script/scene text
# generation. Defaults to true (enabled) when unset.
IMAGE_GENERATION_ENABLED=true
